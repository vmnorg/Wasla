# Copy to transcription/.env. Keep this secret on the backend ONLY.
# Never put API keys in public/, JavaScript, URLs, or source control.
GEMINI_API_KEY=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost,http://127.0.0.1,http://[::1]:8000,http://[::1]:8001
MAX_SESSIONS=4
MAX_SESSION_SECONDS=600
